    {
      "id": "ko_topik1_d002",
      "title": "식당에서 (At a Restaurant)",
      "topic": "food",
      "difficulty": "beginner",
      "lines": [
        {
          "speaker": "A",
          "text": "어서 오세요. 몇 분이세요?",
          "translation_en": "Welcome. How many people?",
          "translation_zh": "欢迎光临。请问几位？",
          "translation_zh_TW": "歡迎光臨。請問幾位？",
          "translation_es": "Bienvenidos. ¿Cuántos son?",
          "translation_fr": "Bienvenue. Combien de personnes ?",
          "translation_de": "Herzlich willkommen. Wie viele Personen?"
        },
        {
          "speaker": "B",
          "text": "두 명이요.",
          "translation_en": "Two people.",
          "translation_zh": "两个人。",
          "translation_zh_TW": "兩個人。",
          "translation_es": "Dos personas.",
          "translation_fr": "Deux personnes.",
          "translation_de": "Zwei Personen."
        },
        {
          "speaker": "A",
          "text": "이쪽으로 오세요.",
          "translation_en": "This way, please.",
          "translation_zh": "请往这边走。",
          "translation_zh_TW": "請往這邊走。",
          "translation_es": "Por aquí, por favor.",
          "translation_fr": "Par ici, s'il vous plaît.",
          "translation_de": "Bitte hier entlang."
        },
        {
          "speaker": "B",
          "text": "메뉴 좀 보여 주세요.",
          "translation_en": "Please show me the menu.",
          "translation_zh": "请给我看一下菜单。",
          "translation_zh_TW": "請給我看菜單。",
          "translation_es": "Por favor, muéstreme el menú.",
          "translation_fr": "Pouvez-vous me montrer le menu ?",
          "translation_de": "Bitte zeigen Sie mir die Speisekarte."
        },
        {
          "speaker": "A",
          "text": "뭐 드시겠어요?",
          "translation_en": "What would you like to eat?",
          "translation_zh": "你想吃点什么？",
          "translation_zh_TW": "你想吃什麼？",
          "translation_es": "¿Qué te apetece comer?",
          "translation_fr": "Qu'est-ce que tu aimerais manger ?",
          "translation_de": "Was möchtest du essen?"
        },
        {
          "speaker": "B",
          "text": "김치찌개 주세요.",
          "translation_en": "Kimchi stew, please.",
          "translation_zh": "请来一碗泡菜汤。",
          "translation_zh_TW": "請給我一份泡菜燉湯。",
          "translation_es": "Un guiso de kimchi, por favor.",
          "translation_fr": "Un ragoût au kimchi, s'il vous plaît.",
          "translation_de": "Bitte einen Kimchi-Eintopf."
        }
      ],
      "vocabulary_focus": [
        "몇 분",
        "메뉴",
        "주세요"
      ],
      "grammar_focus": [
        "(으)세요",
        "아/어 주세요"
      ],
      "source": "Standard conversational Korean",
      "source_status": "STANDARD_REFERENCE"
    },
    {
      "id": "ko_topik1_d003",
      "title": "쇼핑 (Shopping)",
      "topic": "shopping",
      "difficulty": "beginner",
      "lines": [
        {
          "speaker": "A",
          "text": "이거 얼마예요?",
          "translation_en": "How much is this?",
          "translation_zh": "这个多少钱？",
          "translation_zh_TW": "這個要多少錢？",
          "translation_es": "¿Cuánto cuesta esto?",
          "translation_fr": "Combien ça coûte ?",
          "translation_de": "Wie viel kostet das?"
        },
        {
          "speaker": "B",
          "text": "만 원이에요.",
          "translation_en": "It's 10,000 won.",
          "translation_zh": "是1万韩元。",
          "translation_zh_TW": "要一萬韓元。",
          "translation_es": "Cuesta 10 000 wones.",
          "translation_fr": "Ça coûte 10 000 wons.",
          "translation_de": "Das kostet 10.000 Won."
        },
        {
          "speaker": "A",
          "text": "너무 비싸요. 좀 깎아 주세요.",
          "translation_en": "Too expensive. Please give me a discount.",
          "translation_zh": "太贵了。请给我打个折。",
          "translation_zh_TW": "太貴了。請給我折扣。",
          "translation_es": "Es demasiado caro. Por favor, hágame un descuento.",
          "translation_fr": "C'est trop cher. Pourriez-vous me faire une réduction ?",
          "translation_de": "Zu teuer. Bitte gewähren Sie mir einen Rabatt."
        },
        {
          "speaker": "B",
          "text": "그럼 팔천 원에 드릴게요.",
          "translation_en": "Then I'll give it to you for 8,000 won.",
          "translation_zh": "那我就卖给你8,000韩元。",
          "translation_zh_TW": "那我就以8,000韓元賣給你。",
          "translation_es": "Entonces te lo venderé por 8.000 wones.",
          "translation_fr": "Dans ce cas, je te le vends 8 000 wons.",
          "translation_de": "Dann verkaufe ich es dir für 8.000 Won."
        },
        {
          "speaker": "A",
          "text": "좋아요. 이거 주세요.",
          "translation_en": "Okay. I'll take this.",
          "translation_zh": "好的，我来处理这个。",
          "translation_zh_TW": "好的。我來處理這個。",
          "translation_es": "Vale. Me lo quedo.",
          "translation_fr": "D'accord. Je vais le prendre.",
          "translation_de": "Okay. Das nehme ich."
        }
      ],
      "vocabulary_focus": [
        "얼마",
        "비싸요",
        "주세요"
      ],
      "grammar_focus": [
        "이에요/예요",
        "(으)ㄹ게요"
      ],
      "source": "Standard conversational Korean",
      "source_status": "STANDARD_REFERENCE"
    },
    {
      "id": "ko_topik1_d004",
      "title": "길 묻기 (Asking Directions)",
      "topic": "directions",
      "difficulty": "beginner",
      "lines": [
        {
          "speaker": "A",
          "text": "실례합니다. 지하철역이 어디예요?",
          "translation_en": "Excuse me. Where is the subway station?",
          "translation_zh": "请问，地铁站在哪里？",
          "translation_zh_TW": "請問，地鐵站在哪裡？",
          "translation_es": "Disculpe. ¿Dónde está la estación de metro?",
          "translation_fr": "Excusez-moi. Où se trouve la station de métro ?",
          "translation_de": "Entschuldigung. Wo ist die U-Bahn-Station?"
        },
        {
          "speaker": "B",
          "text": "저기예요. 똑바로 가서 오른쪽으로 가세요.",
          "translation_en": "Over there. Go straight and go right.",
          "translation_zh": "在那边。直走，然后右转。",
          "translation_zh_TW": "在那邊。直走然後右轉。",
          "translation_es": "Por ahí. Sigue recto y gira a la derecha.",
          "translation_fr": "Par là. Continuez tout droit, puis tournez à droite.",
          "translation_de": "Da drüben. Geh geradeaus und dann rechts."
        },
        {
          "speaker": "A",
          "text": "감사합니다.",
          "translation_en": "Thank you.",
          "translation_zh": "谢谢。",
          "translation_zh_TW": "謝謝。",
          "translation_es": "Gracias.",
          "translation_fr": "Merci.",
          "translation_de": "Danke."
        },
        {
          "speaker": "B",
          "text": "아니에요.",
          "translation_en": "You're welcome.",
          "translation_zh": "不客气。",
          "translation_zh_TW": "不客氣。",
          "translation_es": "De nada.",
          "translation_fr": "De rien.",
          "translation_de": "Gern geschehen."
        }
      ],
      "vocabulary_focus": [
        "지하철역",
        "어디",
        "똑바로",
        "오른쪽"
      ],
      "grammar_focus": [
        "이에요/예요",
        "(으)세요"
      ],
      "source": "Standard conversational Korean",
      "source_status": "STANDARD_REFERENCE"
    },
    {
      "id": "ko_topik1_d005",
      "title": "약속 (Making Plans)",
      "topic": "plans",
      "difficulty": "beginner",
      "lines": [
        {
          "speaker": "A",
          "text": "주말에 뭐 할 거예요?",
          "translation_en": "What will you do on the weekend?",
          "translation_zh": "周末你打算做什么？",
          "translation_zh_TW": "這個週末你打算做什麼？",
          "translation_es": "¿Qué vas a hacer este fin de semana?",
          "translation_fr": "Que vas-tu faire ce week-end ?",
          "translation_de": "Was machst du am Wochenende?"
        },
        {
          "speaker": "B",
          "text": "친구하고 영화를 볼 거예요.",
          "translation_en": "I'm going to watch a movie with a friend.",
          "translation_zh": "我要和朋友去看电影。",
          "translation_zh_TW": "我要和朋友去看電影。",
          "translation_es": "Voy a ver una película con un amigo.",
          "translation_fr": "Je vais aller voir un film avec un ami.",
          "translation_de": "Ich werde mir mit einem Freund einen Film ansehen."
        },
        {
          "speaker": "A",
          "text": "같이 가도 돼요?",
          "translation_en": "Can I come along?",
          "translation_zh": "我可以一起去吗？",
          "translation_zh_TW": "我可以一起去嗎？",
          "translation_es": "¿Puedo ir contigo?",
          "translation_fr": "Je peux venir avec vous ?",
          "translation_de": "Darf ich mitkommen?"
        },
        {
          "speaker": "B",
          "text": "네, 같이 가요!",
          "translation_en": "Yes, let's go together!",
          "translation_zh": "好的，我们一起去吧！",
          "translation_zh_TW": "好，我們一起去吧！",
          "translation_es": "¡Sí, vamos juntos!",
          "translation_fr": "Oui, allons-y ensemble !",
          "translation_de": "Ja, lass uns zusammen gehen!"
        }
      ],
      "vocabulary_focus": [
        "주말",
        "친구",
        "영화",
        "같이"
      ],
      "grammar_focus": [
        "(으)ㄹ 거예요",
